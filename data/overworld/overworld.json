                        {
                            "speaker": {
                                "name": "Carol",
                                "sprite": "carol_neutral"
                            },
                            "text": "What about Christopher?"
                        },
                        {
                            "speaker": {
                                "name": "Michael Cera",
                                "sprite": "michael_cera_neutral"
                            },
                            "text": "...who?"
                        },
                        {
                            "speaker": {
                                "name": "Carol",
                                "sprite": "carol_neutral"
                            },
                            "text": "Christopher Mintz-Plasse"
                        },
                        {
                            "speaker": {
                                "name": "Michael Cera",
                                "sprite": "michael_cera_neutral"
                            },
                            "text": "...wait ...did he play one of the cops chasing down McLovin?"
                        },
                        {
                            "speaker": {
                                "name": "Carol",
                                "sprite": "carol_neutral"
                            },
                            "text": "...",
