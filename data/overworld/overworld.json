                    "dialogue": [
                        {
                            "speaker": {
                                "name": "Michael Cera",
                                "sprite": "michael_cera_neutral"
                            },
                            "text": "Hey Carol! I need your help! I'm trying to pitch a Superbad legacy sequel, but there is a big problem!"
